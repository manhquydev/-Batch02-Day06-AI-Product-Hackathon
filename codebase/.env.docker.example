# Copy thành .env (cùng thư mục docker-compose.yml) để override build args / biến compose
# Guest UI proxy qua Next → backend (tránh CORS). Để trống NEXT_PUBLIC_API_URL:
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_USE_REAL_API=true
NEXT_PUBLIC_DEFAULT_MODEL=openai/gpt-4o-mini

TMDB_LANGUAGE=vi-VN
TMDB_REGION=VN
